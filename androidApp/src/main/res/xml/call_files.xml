<?xml version="1.0" encoding="utf-8"?>
<!-- Saved calls (Save calls, phase 6) leave the app only through Share; the camera app writes a selfie for Your picture
     into cache/selfie (read once, then deleted); and a shared file's original that came opens in an app that reads it
     (cache/media-originals). The only folders the FileProvider serves. -->
<paths>
    <files-path name="calls" path="calls/" />
    <cache-path name="selfie" path="selfie/" />
    <cache-path name="media" path="media-originals/" />
</paths>
