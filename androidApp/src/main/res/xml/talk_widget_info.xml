<?xml version="1.0" encoding="utf-8"?>
<!-- One conversation's talk button on the home screen (1x1 or 2x1). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.chencohen.ptt.TalkWidgetConfigureActivity"
    android:description="@string/widget_description"
    android:initialLayout="@layout/talk_widget"
    android:minWidth="56dp"
    android:minHeight="56dp"
    android:minResizeWidth="56dp"
    android:minResizeHeight="56dp"
    android:maxResizeWidth="220dp"
    android:maxResizeHeight="110dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
